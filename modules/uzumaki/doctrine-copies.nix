# OPS-754: regular-file doctrine for Cowork and existing Codex worker homes.
# Only mbp2607 opts in. pi/grok share this payload; marker harnesses retain
# their upstream kernel-only payload and preserve personal text outside it.
{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.inspr.doctrineCopies;
  kernel = config.inspr.agent-kernel;
  marker = "<!-- Generated by inspr.doctrineCopies; edit the nixcfg sources. -->";
  # Read the configured kernel paths, never a vendored or independently pinned copy.
  sources = [ kernel.source ] ++ kernel.extraSources;
  generate =
    name: agreements:
    pkgs.writeText "inspr-doctrine-${name}.md" (
      marker + "\n\n" + lib.concatStringsSep "\n\n" (map builtins.readFile (sources ++ [ agreements ]))
    );
  standard = generate "personal" ./personal-agreements.md;
  # Preserve the complete existing builder-home agreements, including their
  # older approval policy and worker baseline; canonical personal text is absent.
  worker = generate "worker" ./builder-home-agreements.md;
  workerTargets =
    map
      (account: {
        path = ".local/share/inspr/codex/${account}/AGENTS.md";
        requiredDirectory = ".local/share/inspr/codex/${account}";
        source = worker;
      })
      [
        "markus"
        "admin"
        "agentone"
      ];
  targets = pkgs.writeText "inspr-doctrine-targets.json" (
    builtins.toJSON {
      inherit marker;
      targets = [
        {
          path = "Claude/CLAUDE.md";
          source = standard;
        }
      ]
      ++ workerTargets;
    }
  );
  installer = pkgs.writeText "inspr-doctrine-copies.py" (builtins.readFile ./doctrine-copies.py);
in
{
  options.inspr.doctrineCopies.enable = lib.mkEnableOption "doctrine copies for Cowork, Codex workers, pi and grok";

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion =
          kernel.enable
          && toString kernel.source == inputs.inspr-modules.outPath + "/docs/AGENTS-KERNEL.md"
          && kernel.extraSources == [ ./agent-kernel-private.md ];
        message = "Doctrine copies require the agent-kernel pinned public source and single nixcfg private source.";
      }
    ];

    home.file = {
      ".pi/agent/AGENTS.md".source = standard;
      ".grok/AGENTS.md".source = standard;
    };
    home.activation.insprDoctrineCopies = lib.hm.dag.entryAfter [ "linkGeneration" ] ''
      if [ -n "''${DRY_RUN_CMD:-}" ]; then
        printf '%s\n' 'Would update INSPR doctrine copies (Cowork and existing Codex homes).'
      else
        ${pkgs.python3}/bin/python3 ${installer} "$HOME" ${targets}
      fi
    '';
  };
}
