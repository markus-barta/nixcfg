{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	# Legacy routing adds /janus to the host agent's /internal requests.
	@internal path /internal /internal/* /janus/internal /janus/internal/*
	handle @internal {
		respond "" 204
	}
	handle {
		# Serve the same maintenance response for mutations; keep HEAD bodyless.
		@pageBody not method HEAD
		method @pageBody GET
		header {
			Retry-After 86400
			Cache-Control no-store
			X-Robots-Tag noindex
		}
		root * /srv/janus-placeholder
		rewrite * /index.html
		file_server {
			status 503
		}
	}
}
