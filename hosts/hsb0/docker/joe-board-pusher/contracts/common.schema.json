{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:joedesk:common:v2",
  "$defs": {
    "instant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "date": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "decimal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,8})?$"
    },
    "fx": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "quote",
        "rate",
        "source",
        "observedAt"
      ],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "quote": {
          "const": "EUR"
        },
        "rate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(?:0\\.[0-9]{1,8}|[1-9][0-9]*(?:\\.[0-9]{1,8})?)$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "observedAt": {
          "$ref": "urn:joedesk:common:v2#/$defs/instant"
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency"
      ],
      "properties": {
        "amount": {
          "$ref": "urn:joedesk:common:v2#/$defs/decimal"
        },
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3,
          "pattern": "^[A-Z]{3}$"
        },
        "fx": {
          "$ref": "#/$defs/fx"
        }
      }
    }
  }
}
